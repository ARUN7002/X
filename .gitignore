# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# ---------------------------------------------------------------- X-MUX backend
# Runtime data (SQLite database + WAL files) — lives on the backend host only.
backend/data/
# Auto-downloaded model caches (speechbrain ECAPA / silero VAD artifacts).
backend/models/ecapa/
backend/models/silero/
# Python runtime artifacts.
backend/__pycache__/
__pycache__/
*.pyc
backend/backend.log
backend/.pytest_cache/
# Model checkpoints are ignored by default EXCEPT the small tracked AASIST-L
# checkpoint (426 KB, MIT-licensed, part of the repository).
*.pth
!backend/models/AASIST-L.pth
*.onnx

# ---------------------------------------------------------------- X-MUX training
# Experiment outputs and exported artifacts: content gitignored, .gitkeep kept.
training/experiments/*
!training/experiments/.gitkeep
training/export/*
!training/export/.gitkeep
# Datasets are NEVER committed.
training/data/
datasets/

# ---------------------------------------------------------------- Misc runtime
uploads/
upload/
tool-results/
mini-services-dist/

# ---------------------------------------------------------------- Databases
# SQLite files are runtime data, never source-controlled (spec PART 32).
*.db
*.sqlite
*.sqlite3
